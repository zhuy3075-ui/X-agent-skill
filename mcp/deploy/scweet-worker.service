[Unit]
Description=Scweet background collector
After=network-online.target postgresql.service

[Service]
Type=simple
User=scweet
WorkingDirectory=/opt/x-agent-skill
EnvironmentFile=/etc/scweet/worker.env
ExecStart=/opt/x-agent-skill/.venv/bin/python /opt/x-agent-skill/run.py worker --config /etc/scweet/config.json
Restart=on-failure
TimeoutStopSec=30
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
