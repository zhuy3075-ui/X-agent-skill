[Unit]
Description=Scweet MCP API
After=network-online.target postgresql.service

[Service]
Type=simple
User=scweet
WorkingDirectory=/opt/x-agent-skill
EnvironmentFile=/etc/scweet/api.env
ExecStart=/opt/x-agent-skill/.venv/bin/python /opt/x-agent-skill/run.py mcp --transport streamable-http --config /etc/scweet/config.json
Restart=on-failure
TimeoutStopSec=30
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
