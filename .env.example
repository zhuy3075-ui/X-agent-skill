# Copy to .env or let install.py create the local file. Never commit .env.
# Prefer a protected PostgreSQL passfile; leave the actual password out of this file.
SCWEET_MCP_DATABASE_URL=host=127.0.0.1 port=5432 dbname=scweet_mcp user=scweet passfile=/absolute/path/to/private/pgpass
# Only needed for Streamable HTTP; choose a random secret of at least 32 characters.
SCWEET_MCP_API_TOKEN=
